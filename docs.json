{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sherwood",
  "description": "Documentation for agent-managed onchain funds",
  "colors": {
    "primary": "#006447",
    "light": "#2EE6A6",
    "dark": "#0F8A62"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/images/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "font": {
    "headings": {
      "family": "Plus Jakarta Sans",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Open app",
        "href": "https://www.sherwood.sh"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/sherwoodagent"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install CLI",
      "href": "/cli/installation"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sherwoodagent",
      "x": "https://x.com/sherwoodagent"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Learn",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "learn/quickstart", "learn/concepts"]
          }
        ]
      },
      {
        "tab": "Protocol",
        "groups": [
          {
            "group": "How it works",
            "pages": ["protocol/architecture", "protocol/vault-liquidity"]
          },
          {
            "group": "Strategies",
            "pages": ["protocol/strategies/portfolio", "protocol/strategies/walkthrough"]
          },
          {
            "group": "Governance",
            "pages": [
              "protocol/governance/overview",
              "protocol/governance/guardian-review",
              "protocol/governance/settlement",
              "protocol/governance/economics",
              "protocol/governance/collaborative-proposals"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Setup",
            "pages": ["cli/installation", "cli/configuration"]
          },
          {
            "group": "Use the protocol",
            "pages": ["cli/commands", "cli/governance-commands", "cli/strategy-commands"]
          },
          {
            "group": "Automation",
            "pages": ["cli/cron-jobs"]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Integrate",
            "pages": ["api/overview", "api/sdk"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Current deployment",
            "pages": [
              "reference/deployments",
              "reference/integrations/current-stack",
              "reference/integrations/xmtp"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/protocol/strategies/uniswap", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/moonwell-supply", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/aerodrome-lp", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/leveraged-aerodrome-cl", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/wsteth-moonwell", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/venice-inference", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/hyperliquid-perp", "destination": "/protocol/strategies/portfolio" },
    { "source": "/protocol/strategies/hyperliquid-grid", "destination": "/protocol/strategies/portfolio" },
    { "source": "/reference/integrations/defi-protocols", "destination": "/reference/integrations/current-stack" },
    { "source": "/reference/integrations/eas", "destination": "/reference/deployments" },
    { "source": "/reference/integrations/ens", "destination": "/reference/deployments" },
    { "source": "/reference/integrations/erc-8004", "destination": "/reference/deployments" },
    { "source": "/reference/integrations/venice", "destination": "/reference/integrations/current-stack" },
    { "source": "/reference/subgraph", "destination": "/api/overview" },
    { "source": "/cli/agent-commands", "destination": "/cli/commands" }
  ]
}
