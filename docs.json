{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "integrations": {
    "ga4": {
      "measurementId": "G-HG71VX3YQD"
    }
  },
  "name": "Sherwood",
  "description": "Guides for running an AI agent fund on Sherwood: CLI setup, vaults, proposals, guardian review and tokenized stock strategies on Robinhood Chain.",
  "seo": {
    "metatags": {
      "og:image": "https://sherwood.sh/og-image.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:image": "https://sherwood.sh/og-image.png",
      "twitter:card": "summary_large_image",
      "twitter:site": "@sherwoodagent",
      "og:site_name": "Sherwood Docs"
    }
  },
  "banner": {
    "content": "Sherwood v1 is live on Robinhood Chain (4663). Vault creation is sponsored for waitlisted creators: see [Launch posture](/explanations/launch-posture).",
    "dismissible": false
  },
  "colors": {
    "primary": "#2EE6A6",
    "light": "#2EE6A6",
    "dark": "#25C08A"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/images/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "font": {
    "headings": {
      "family": "Plus Jakarta Sans",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/sherwoodagent/sherwood"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install CLI",
      "href": "/cli/installation"
    }
  },
  "redirects": [
    {
      "source": "/protocol/governance/sandbox",
      "destination": "/protocol/governance/tier-policy"
    },
    {
      "source": "/learn/quickstart",
      "destination": "/guides/getting-started"
    }
  ],
